# syntax=docker/dockerfile:1
# Bootstrap only. Source/runtime images consume its published immutable digest.
FROM --platform=linux/amd64 debian:bookworm-slim@sha256:c67e92c8099ba22853ab4cfda7cfb494d253d6012ca82dee98ba8976772af018
LABEL org.opencontainers.image.source="https://github.com/darkquasar/batz" \
      dev.batz.image-role="linux-bootstrap-tools"
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl tar gzip xz-utils git procps python3 docker.io strace \
    && rm -rf /var/lib/apt/lists/*
COPY runtime/dependencies.lock.json /tmp/batz-runtime-lock.json
RUN python3 -I -B - <<'PY'
import hashlib, json, pathlib, urllib.request
lock = json.loads(pathlib.Path('/tmp/batz-runtime-lock.json').read_bytes())
artifact = lock['mise']['artifacts']['linux/amd64']
data = urllib.request.urlopen(artifact['url'], timeout=120).read()
if hashlib.sha256(data).hexdigest() != artifact['sha256']:
    raise ValueError('mise bootstrap checksum mismatch')
destination = pathlib.Path('/usr/local/bin/mise')
destination.write_bytes(data)
destination.chmod(0o755)
PY
