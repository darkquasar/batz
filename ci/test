#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python="$root/runtime/.local/venv/bin/python"
if [ ! -x "$python" ]; then
    echo "missing pinned Python runtime: $python" >&2
    exit 3
fi
"$python" -I -B "$root/ci/setup.py" --check
exec "$python" -I -B "$root/ci/test.py" "$@"
