{
  "apiVersion": "batz/v0alpha1",
  "kind": "SourcePipeline",
  "name": "aws-cloudtrail",
  "version": 1,
  "normalization": {
    "project": "repo://normalization"
  },
  "routes": {
    "local_raw": {
      "input": {
        "engine": "bento",
        "config": "repo://collector/configs/cloudtrail/local-records.yaml",
        "params": {
          "path": {
            "type": "path",
            "required": true,
            "env": "BATZ_SOURCE_PATH"
          }
        }
      },
      "output": {
        "parsed": {
          "format": "parquet"
        },
        "normalized": {
          "models": {
            "api_activity": "cloudtrail.api_activity"
          }
        }
      }
    }
  }
}
