+func TestInvalidReviewedExpectationsRemainIntegrityFailures(t *testing.T) {
+	tests := []struct {
+		name string
+		from string
+		to   string
+	}{
+		{name: "wrong dataset", from: "api_activity", to: "unknown-output"},
+		{name: "missing expected field", from: "event.action", to: "event.missing"},
