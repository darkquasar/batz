+			data, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var config map[string]any
+			if err := json.Unmarshal(data, &config); err != nil {
+				t.Fatal(err)
+			}
+			settings := config
+			for _, key := range []string{"gateways", "local", tt.connection, "connector_config"} {
+				nested, ok := settings[key].(map[string]any)
