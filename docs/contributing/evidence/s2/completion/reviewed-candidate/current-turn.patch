+type previewConnection struct {
+	Type            string            `json:"type"`
+	ConcurrentTasks int               `json:"concurrent_tasks"`
+	Extensions      []json.RawMessage `json:"extensions"`
+	ConnectorConfig struct {
+		Threads     int   `json:"threads"`
