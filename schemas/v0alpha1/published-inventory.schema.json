{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batz.invalid/schemas/v0alpha1/published-inventory.schema.json",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "batz/v0alpha1"
    },
    "kind": {
      "const": "PublishedInventory"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "identity": {
      "$ref": "common.schema.json#/$defs/identity"
    },
    "input_revision": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "input_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/input"
      }
    },
    "profile": {
      "const": "batz-investigation/v0alpha1"
    },
    "content": {
      "$ref": "common.schema.json#/$defs/hashes"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/file"
            }
          },
          "rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "name",
          "model_id",
          "schema",
          "files",
          "rows"
        ],
        "additionalProperties": false
      }
    },
    "source_files": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/file"
      }
    },
    "reject_files": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/file"
      }
    },
    "counts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/counts"
      }
    },
    "quality": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "catalog": {
      "$ref": "common.schema.json#/$defs/file"
    },
    "reconciliation": {
      "$ref": "common.schema.json#/$defs/reconciliation"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "revision",
    "identity",
    "input_revision",
    "input_digest",
    "inputs",
    "profile",
    "content",
    "datasets",
    "source_files",
    "reject_files",
    "counts",
    "quality",
    "catalog"
  ],
  "additionalProperties": false
}
