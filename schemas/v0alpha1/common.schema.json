{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batz.invalid/schemas/v0alpha1/common.schema.json",
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "batch_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "binding_id",
        "run_id",
        "batch_id",
        "attempt_id",
        "case_id"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\\\x00-\\x1f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "rows"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "id",
        "locator",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "boundary": {
          "enum": [
            "parse",
            "normalize"
          ]
        },
        "accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "excluded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "boundary",
        "accepted",
        "rejected",
        "unsupported",
        "excluded"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "input_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "collection_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "model_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "collector_memory_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "model_memory_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "duckdb_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "scratch_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "collection_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "model_slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "input_files",
        "input_bytes",
        "records",
        "collection_seconds",
        "model_seconds",
        "collector_memory_bytes",
        "model_memory_bytes",
        "duckdb_threads",
        "scratch_bytes",
        "collection_slots",
        "model_slots"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "invalid-input",
            "incomplete-capability",
            "integrity",
            "assertion",
            "execution",
            "busy",
            "cancelled",
            "authorization",
            "partial",
            "mixed"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "category",
        "code",
        "field",
        "source",
        "message"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "resource_usage": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "unavailable_samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sample_interval_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "average_rss_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "peak_rss_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "scratch_peak_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "samples",
        "unavailable_samples",
        "sample_interval_ms",
        "wall_ms",
        "average_rss_bytes",
        "peak_rss_bytes",
        "measurement_error",
        "scratch_peak_bytes"
      ],
      "additionalProperties": false
    }
  }
}
